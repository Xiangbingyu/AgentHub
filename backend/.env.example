APP_NAME=AgentHub Backend
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# JSON array, for example: ["http://localhost:3000","http://127.0.0.1:5173"]
CORS_ALLOW_ORIGINS=["*"]

AGENTSCOPE_PROVIDER=dashscope
AGENTSCOPE_MODEL=qwen3.6-plus
AGENTSCOPE_MOUNT_PATH=/agentscope

# Default runtime: DashScope + qwen3.6-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=
DASHSCOPE_API_KEY=

# If you switch to OpenAI-compatible mode, set:
# AGENTSCOPE_PROVIDER=openai
# AGENTSCOPE_MODEL=glm-5
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
